<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid-Automation-CrossBrowser"
	parallel="tests"
	thread-count="5">

	<!-- ================= LISTENERS ================= -->
	<listeners>
		<listener class-name="com.framework.utils.reports.ExtentReportListener" />
	</listeners>

	<!-- ================= GROUP CONTROL ================= -->
	<groups>
		<run>
			<include name="Regression" />
			<include name="Sanity" />
			<include name="Smoke" />
			<include name="CoreFlow" />
		</run>
	</groups>

	<!-- ================= CHROME ================= -->
	<test name="ChromeTests">
		<parameter name="os" value="LINUX" />
		<parameter name="browser" value="chrome" />

		<packages>
			<package name="com.framework.tests.*" />
		</packages>
	</test>

	<!-- ================= EDGE ================= -->
	<test name="EdgeTests">
		<parameter name="os" value="LINUX" />
		<parameter name="browser" value="edge" />

		<packages>
			<package name="com.framework.tests.*" />
		</packages>
	</test>

	<!-- ================= FIREFOX ================= -->
	<test name="FirefoxTests">
		<parameter name="os" value="LINUX" />
		<parameter name="browser" value="firefox" />

		<packages>
			<package name="com.framework.tests.*" />
		</packages>
	</test>

</suite>
