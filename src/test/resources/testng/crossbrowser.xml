<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid-Automation-CrossBrowser"
       parallel="tests"
       thread-count="5">

    <!-- ================= LISTENERS ================= -->
    <listeners>
        <listener class-name="com.framework.utils.reports.ExtentReportListener"/>
    </listeners>

    <!-- ================= GROUP CONTROL ================= -->
    <groups>
        <run>
            <include name="Master"/>
            <!-- <include name="Sanity"/> -->
            <!-- <include name="Regression"/> -->
            <!-- <exclude name="E2E"/> -->
        </run>
    </groups>

    <!-- ================= CHROME ================= -->
    <test name="ChromeTests">
        <parameter name="os" value="WIN10"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.framework.tests.registration.RegistrationTests"/>
            <class name="com.framework.tests.login.LoginTests"/>
            <class name="com.framework.tests.search.SearchTests"/>
            <class name="com.framework.tests.product.ProductDetailsTests"/>
            <class name="com.framework.tests.cart.CartTests"/>
            <class name="com.framework.tests.purchase.PurchaseTests"/>
        </classes>
    </test>

    <!-- ================= EDGE ================= -->
    <test name="EdgeTests">
        <parameter name="os" value="WIN10"/>
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="com.framework.tests.register.RegisterTests"/>
            <class name="com.framework.tests.login.LoginTests"/>
            <class name="com.framework.tests.search.SearchTests"/>
            <class name="com.framework.tests.product.ProductDetailsTests"/>
            <class name="com.framework.tests.cart.CartTests"/>
            <class name="com.framework.tests.purchase.PurchaseTests"/>
        </classes>
    </test>

    <!-- ================= FIREFOX (OPTIONAL) ================= -->
    <!--
    <test name="FirefoxTests">
        <parameter name="os" value="LINUX"/>
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="com.framework.tests.register.RegisterTests"/>
            <class name="com.framework.tests.login.LoginTests"/>
            <class name="com.framework.tests.search.SearchTests"/>
            <class name="com.framework.tests.product.ProductDetailsTests"/>
            <class name="com.framework.tests.cart.CartTests"/>
            <class name="com.framework.tests.purchase.PurchaseTests"/>
        </classes>
    </test>
    -->

</suite>
