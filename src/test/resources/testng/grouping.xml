<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid-Automation-Suite" parallel="tests" thread-count="5">

	<!-- ================= LISTENERS ================= -->
	<listeners>
		<listener class-name="com.framework.utils.reports.ExtentReportListener" />
	</listeners>

	<!-- ================= GROUP CONTROL ================= -->
	<groups>
		<run>
			<include name="Master" />
			<!-- <include name="Sanity"/> -->
			<!-- <include name="Regression"/> -->
			<!-- <exclude name="E2E"/> -->
		</run>
	</groups>

	<!-- ================= TEST BLOCK ================= -->
	<test name="Web-UI-Tests">

		<!-- Environment Parameters -->
		<parameter name="os" value="Windows" />
		<parameter name="browser" value="edge" />

		<!-- ================= FEATURE CLASSES ================= -->
		<classes>

			<!-- Registration Feature -->
			<class name="com.framework.tests.register.RegisterTests" />

			<!-- Login Feature -->
			<class name="com.framework.tests.login.LoginTests" />

			<!-- Search Feature -->
			<class name="com.framework.tests.search.SearchTests" />

			<!-- Product Feature -->
			<class name="com.framework.tests.product.ProductDetailsTests" />

			<!-- Cart Feature -->
			<class name="com.framework.tests.cart.CartTests" />

			<!-- End-to-End Purchase -->
			<class name="com.framework.tests.purchase.PurchaseTests" />

		</classes>

	</test>

</suite>
