<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid-Automation-Suite"
       parallel="tests"
       thread-count="5">

    <!-- ================= LISTENERS ================= -->
    <listeners>
        <listener class-name="com.framework.utils.reports.ExtentReportListener"/>
    </listeners>

    <!-- ================= GROUP CONTROL ================= -->
    <groups>
        <run>
            <!-- Full enterprise regression -->
            <include name="Regression"/>

            <!-- Optional exclusions -->
            <!-- <exclude name="E2E"/> -->
            <!-- <exclude name="Negative"/> -->
        </run>
    </groups>

    <!-- ================= TEST BLOCK ================= -->
    <test name="Web-UI-Tests">

        <!-- Environment Parameters -->
        <parameter name="os" value="LINUX"/>
        <parameter name="browser" value="chrome"/>

        <!-- ================= FEATURE PACKAGES ================= -->
        <packages>
            <package name="com.framework.tests.registration"/>
            <package name="com.framework.tests.login"/>
            <package name="com.framework.tests.search"/>
            <package name="com.framework.tests.product"/>
            <package name="com.framework.tests.cart"/>
            <package name="com.framework.tests.purchase"/>
        </packages>

    </test>

</suite>
