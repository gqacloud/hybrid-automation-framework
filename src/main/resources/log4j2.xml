<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="basePath">./logs</Property>
    </Properties>

    <Appenders>
        <RollingFile name="File"
                     fileName="${basePath}/automation.log"
                     filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{36} - %msg%n"/>

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>

            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>

        <Root level="INFO">
            <AppenderRef ref="File"/>
        </Root>

        <!-- Test lifecycle -->
        <Logger name="TEST-LIFECYCLE" level="INFO" additivity="false">
            <AppenderRef ref="File"/>
        </Logger>

        <!-- Page Objects -->
        <Logger name="com.framework.pages" level="INFO" additivity="false">
            <AppenderRef ref="File"/>
        </Logger>

        <!-- Utils / Helpers -->
        <Logger name="com.framework.utils" level="WARN" additivity="false">
            <AppenderRef ref="File"/>
        </Logger>

        <!-- Driver / Infra -->
        <Logger name="com.framework.driver" level="INFO" additivity="false">
            <AppenderRef ref="File"/>
        </Logger>

    </Loggers>
</Configuration>
