<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">

    <!-- ========================================================= -->
    <!-- PROPERTIES -->
    <!-- ========================================================= -->
    <Properties>

        <!-- Base log folder (per run) -->
        <Property name="basePath">
            logs/${sys:runId:-default-run}
        </Property>

        <!-- Unified one-line log pattern -->
        <Property name="logPattern">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [TEST:%-25X{testName}] [THREAD:%-3X{threadId}] %-5level %-40logger{36} - %msg%n
        </Property>

    </Properties>

    <!-- ========================================================= -->
    <!-- APPENDERS -->
    <!-- ========================================================= -->
    <Appenders>

        <!-- Rolling File Appender -->
        <RollingFile name="FileLogger"
                     fileName="${basePath}/automation.log"
                     filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">

            <PatternLayout pattern="${logPattern}" />

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="5MB" />
            </Policies>

            <DefaultRolloverStrategy max="10" />
        </RollingFile>

    </Appenders>

    <!-- ========================================================= -->
    <!-- LOGGERS -->
    <!-- ========================================================= -->
    <Loggers>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="FileLogger" />
        </Root>

        <!-- Test Lifecycle Logs -->
        <Logger name="TEST-LIFECYCLE" level="INFO" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- Base / Framework Logs -->
        <Logger name="com.framework.base" level="INFO" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- Page Objects -->
        <Logger name="com.framework.pages" level="INFO" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- Utils / Helpers -->
        <Logger name="com.framework.utils" level="WARN" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- Driver / Infrastructure -->
        <Logger name="com.framework.driver" level="INFO" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- Reduce Selenium Noise -->
        <Logger name="org.openqa.selenium" level="WARN" additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

    </Loggers>

</Configuration>
