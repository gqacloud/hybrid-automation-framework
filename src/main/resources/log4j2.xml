<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">

    <!-- ========================================================= -->
    <!-- PROPERTIES -->
    <!-- ========================================================= -->
    <Properties>

        <!-- Base log folder (isolated per run) -->
        <Property name="basePath">
            logs/${sys:runId:-default-run}
        </Property>

        <!-- Unified, scenario-aware log pattern -->
        <Property name="logPattern">
            %d{yyyy-MM-dd HH:mm:ss.SSS}
            [TEST:%-45X{testName}]
            [THREAD:%-5X{threadId}]
            %-5level
            %-40logger{36}
            - %msg%n
        </Property>

    </Properties>

    <!-- ========================================================= -->
    <!-- APPENDERS -->
    <!-- ========================================================= -->
    <Appenders>

        <!-- ================= ROLLING FILE APPENDER ================= -->
        <RollingFile
                name="FileLogger"
                fileName="${basePath}/automation.log"
                filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">

            <PatternLayout pattern="${logPattern}" />

            <Policies>
                <!-- Daily rollover -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <!-- Size-based rollover -->
                <SizeBasedTriggeringPolicy size="5MB" />
            </Policies>

            <DefaultRolloverStrategy max="10" />
        </RollingFile>

    </Appenders>

    <!-- ========================================================= -->
    <!-- LOGGERS -->
    <!-- ========================================================= -->
    <Loggers>

        <!-- ================= ROOT LOGGER ================= -->
        <Root level="INFO">
            <AppenderRef ref="FileLogger" />
        </Root>

        <!-- ================= TEST LIFECYCLE ================= -->
        <!-- BaseTest / listeners / execution flow -->
        <Logger
                name="TEST-LIFECYCLE"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= BASE / FRAMEWORK ================= -->
        <Logger
                name="com.framework.base"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= PAGE OBJECTS ================= -->
        <Logger
                name="com.framework.pages"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= COMPONENTS (TABLE, ETC.) ================= -->
        <Logger
                name="com.framework.components"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= UTILS / HELPERS ================= -->
        <Logger
                name="com.framework.utils"
                level="WARN"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= DRIVER / INFRA ================= -->
        <Logger
                name="com.framework.driver"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= EXTENT REPORT LISTENER ================= -->
        <Logger
                name="com.framework.reports"
                level="INFO"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <!-- ================= REDUCE SELENIUM NOISE ================= -->
        <Logger
                name="org.openqa.selenium"
                level="WARN"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

        <Logger
                name="org.apache.http"
                level="WARN"
                additivity="false">
            <AppenderRef ref="FileLogger" />
        </Logger>

    </Loggers>

</Configuration>
